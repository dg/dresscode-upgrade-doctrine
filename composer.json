{
	"name": "dresscode/upgrade-doctrine",
	"description": "👔 DressCode Upgrade for Doctrine: upgrades code from Doctrine ORM 2 and DBAL 2.13 to ORM 3 and DBAL 4, mapping annotations to attributes included, and reports the rest with what to write instead.",
	"keywords": ["doctrine", "doctrine orm", "orm", "dbal", "entities", "upgrade", "upgrading", "migration", "deprecations", "refactoring", "codemod", "annotations", "attributes", "dresscode", "rector"],
	"homepage": "https://dresscode.run/upgrading-doctrine",
	"type": "dresscode-plugin",
	"license": "MIT",
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": "8.4 - 8.6",
		"dresscode/dresscode": "^1.2"
	},
	"require-dev": {
		"nette/phpstan-rules": "^1.0",
		"nette/tester": "^2.6",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.2"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"scripts": {
		"tester": "tester tests -s",
		"phpstan": "phpstan analyse"
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.0-dev"
		},
		"dresscode": {
			"upgrading-dir": "upgrading",
			"packages": []
		}
	}
}
